SELECT Id, Name, IdExterno__c, UnidadeNegocio__c, Ativo__c, Descricao__c, BusinessHoursName__c, BusinessHoursSecundarioName__c, PossuiBusinessHoursSecundario__c, RegiaoAtendimentoSecundaria__c, StaticResourceName__c, EntitlementProcessName__c, TempoTriagemMinutos__c, TempoRespostaChatMinutos__c, TempoFilaEmailMinutos__c, UsaTempoTriagem__c, UsaTempoRespostaChat__c, UsaTempoFilaEmail__c,
(SELECT Id, Name, IdExterno__c, NomeMarco__c, Ordem__c, Ativo__c, Recorrente__c, TipoRecorrencia__c, FonteTempo__c, MilestoneTypeName__c, TempoFallbackMinutos__c, UsaAreaInterna__c, UsaCategorizacao__c, UsaOrigem__c FROM MarcosSLA__r),
(SELECT Id, RecordTypeId, RecordType.DeveloperName, Assunto__c, Categoria__c, Subassunto__c, TipoCaso__c, UnidadeNegocios__c, Ativo__c, Prioridade__c, Descricao__c, DistribuirParaFila__c, CampoDistribuicao__c, LabelCampoDistribuicao__c, ValorDistribuicao__c, LabelValorDistribuicao__c, FilaId__c, FilaDeveloperName__c, NomeFilaDistribuicao__c, FilaIdFallback__c, FilaDeveloperNameFallback__c, NomeFilaFallbackDistribuicao__c, PermiteAssumirComFilaParametrizada__c, PorCampoCustomizado__c, PorCategorizacao__c, EtapaAtendimentoDistribuicao__c, MotivoInativacao__c, ChaveNatural__c, ChaveNaturalHash__c, ExternalId__c,
(SELECT Id, IdExterno__c, AreaAtendimento__c, Ativo__c, EscopoRegra__c, TempoAlta__c, TempoMedia__c, TempoBaixa__c, BusinessHoursName__c, UsaBusinessHoursSecundario__c, TipoAreaParticipante__c, ChaveUnica__c, ChaveUnicaHash__c, MarcoSLA__c, GestaoSLA__c FROM RegrasSLA__r)
FROM Categorizacoes__r)
FROM GestaoSLA__c
