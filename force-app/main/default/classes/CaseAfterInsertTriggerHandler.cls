/**
 * CaseAfterInsertTriggerHandler
 *
 * Handles after-insert logic for Case records that are NOT covered by
 * the existing CaseTrigger (which handles before insert/update and after update).
 *
 * Responsibility: when new Cases are inserted, enqueue a sync job that will
 * create AreaParticipante__c Standard records from any CaseMilestone records
 * generated by the EntitlementProcess.
 *
 * Note: CaseMilestone records are created asynchronously by Salesforce after
 * the Case is committed. The Queueable fires after the transaction completes,
 * giving Salesforce time to generate the milestones.
 */
public inherited sharing class CaseAfterInsertTriggerHandler {

    public static void afterInsert(List<Case> newList) {
        if (newList == null || newList.isEmpty()) {
            return;
        }
        Set<Id> caseIds = new Set<Id>();
        for (Case c : newList) {
            if (c.Id != null) {
                caseIds.add(c.Id);
            }
        }
        if (!caseIds.isEmpty()) {
            CaseOpeningNotificationService.notifyOpenedCases(caseIds);
            CaseMilestoneSyncQueueable.enqueueSync(caseIds);
        }
        ReclamacaoService.handleClosureOnInsert(newList);
    }
}