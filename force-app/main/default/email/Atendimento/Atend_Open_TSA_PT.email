<messaging:emailTemplate subject="Atendimento aberto | Wilson Sons" recipientType="Contact" relatedToType="Case">
<messaging:htmlEmailBody >
<html><body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#1f2933;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f4f6f8;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px; width:100%; background-color:#003A70;"><tr><td align="center" style="padding:28px 24px 20px 24px;">
<img src="{!URLFOR($Resource.logoWSemail)}" alt="Wilson Sons" width="180" style="display:block; border:0; max-width:180px; height:auto;" />
</td></tr><tr><td align="center" style="padding:0 16px 32px 16px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px; width:100%; background-color:#ffffff; border-radius:8px;"><tr><td style="padding:32px 28px 24px 28px;">
<h1 style="margin:0 0 16px 0; font-size:24px; line-height:32px; font-weight:bold; color:#1f2933;">Atendimento aberto</h1>
<p style="margin:0 0 14px 0; font-size:15px; line-height:23px;">Olá, {!Recipient.Name}.</p>
<p style="margin:0 0 14px 0; font-size:15px; line-height:23px;">Seu ticket de atendimento com o Tecon Salvador foi aberto pela equipe Wilson Sons.</p>
<p style="margin:0 0 22px 0; font-size:15px; line-height:23px;">Nossa equipe acompanhará a solicitação e retornará pelos canais oficiais de atendimento.</p>
<p style="margin:0 0 22px 0; font-size:14px; line-height:22px; color:#4b5563;">Atendimento: {!relatedTo.CaseNumber}</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td style="border-top:1px solid #d9dee5; font-size:1px; line-height:1px;">&#160;</td></tr></table>
<p style="margin:20px 0 0 0; font-size:12px; line-height:18px; color:#697386;">Wilson Sons | Atendimento ao Cliente</p>
</td></tr></table></td></tr></table></td></tr></table>
</body></html>
</messaging:htmlEmailBody>
<messaging:plainTextEmailBody >Olá, {!Recipient.Name}.

Seu ticket de atendimento com o Tecon Salvador foi aberto pela equipe Wilson Sons.

Atendimento: {!relatedTo.CaseNumber}

Wilson Sons | Atendimento ao Cliente
</messaging:plainTextEmailBody>
</messaging:emailTemplate>