<messaging:emailTemplate subject="Rate your support experience | Wilson Sons" recipientType="Contact" relatedToType="SurveyInvitation">
<messaging:htmlEmailBody >
<html><body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#1f2933;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f4f6f8;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px; width:100%; background-color:#003A70;"><tr><td align="center" style="padding:28px 24px 20px 24px;">
<img src="{!URLFOR($Resource.logoWSemail)}" alt="Wilson Sons" width="180" style="display:block; border:0; max-width:180px; height:auto;" />
</td></tr><tr><td align="center" style="padding:0 16px 32px 16px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px; width:100%; background-color:#ffffff; border-radius:8px;"><tr><td style="padding:32px 28px 24px 28px;">
<h1 style="margin:0 0 16px 0; font-size:24px; line-height:32px; font-weight:bold; color:#1f2933;">Customer Satisfaction Survey</h1>
<p style="margin:0 0 14px 0; font-size:15px; line-height:23px;">Hello, {!Recipient.Name}.</p>
<p style="margin:0 0 14px 0; font-size:15px; line-height:23px;">Your support request has been closed and we would like to know about your experience with Wilson Sons.</p>
<p style="margin:0 0 22px 0; font-size:15px; line-height:23px;">Your feedback is important to help us continuously improve our services.</p>
<p style="margin:0 0 20px 0; font-size:15px; line-height:23px;">To answer the survey, please use the link below:</p>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px 0;"><tr><td bgcolor="#0072CE" style="border-radius:4px;">
<a href="{!relatedTo.InvitationLink}" target="_blank" style="display:inline-block; padding:12px 22px; font-size:15px; line-height:20px; color:#ffffff; text-decoration:none; font-weight:bold;">Answer survey</a>
</td></tr></table>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"><tr><td style="border-top:1px solid #d9dee5; font-size:1px; line-height:1px;">&#160;</td></tr></table>
<p style="margin:20px 0 0 0; font-size:12px; line-height:18px; color:#697386;">Wilson Sons | Customer Support</p>
</td></tr></table></td></tr></table></td></tr></table>
</body></html>
</messaging:htmlEmailBody>
<messaging:plainTextEmailBody >Hello, {!Recipient.Name}.

Your support request has been closed and we would like to know about your experience with Wilson Sons.

To answer the survey, please use: {!relatedTo.InvitationLink}

Wilson Sons | Customer Support
</messaging:plainTextEmailBody>
</messaging:emailTemplate>