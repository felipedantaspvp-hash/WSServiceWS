<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Atribui o EntitlementId ao Caso antes de salvar.</description>
        <name>Set_EntitlementId</name>
        <label>Atribuir EntitlementId ao Caso</label>
        <locationX>44</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>$Record.EntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Entitlement.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Verifica se um Entitlement foi encontrado para a Unidade de Negócios.</description>
        <name>Check_Entitlement_Found</name>
        <label>Entitlement encontrado?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Não encontrado</defaultConnectorLabel>
        <rules>
            <name>Entitlement_Encontrado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Entitlement</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_EntitlementId</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <description>Antes de criar um Caso, busca o Entitlement ativo da mesma Unidade de Negócios e atribui automaticamente ao campo EntitlementId.</description>
    <interviewLabel>Case - Atribuição Automática de Entitlement {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - Atribuição Automática de Entitlement</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Busca o Entitlement da mesma Unidade de Negócios do Caso.</description>
        <name>Get_Entitlement</name>
        <label>Buscar Entitlement por Unidade de Negócios</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Entitlement_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UnidadeNegocio__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.UnidadeNegocio__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Entitlement</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Entitlement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UnidadeNegocio__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>EntitlementId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
