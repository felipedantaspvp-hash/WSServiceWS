        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Tipo_CNTR_Edicao</name>
        <dataType>String</dataType>
        <expression>IF(
    /* 1. TESTE DE EXCLUSIVIDADE DO PERÍODO */
    {!$Record.Valor_Formula_Periodo__c} &lt;&gt; {!$Record.Valor_Formula_Periodo_ini__c}, 
    &quot;Edição Valor Formula Período&quot;,

    /* 2. EDIÇÃO 20/40 CONSOLIDADO E 20/40 NÃO CONSOLIDADO (TODOS) */
    IF(AND(
        {!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c},
        {!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c},
        {!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c},
        {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}
    ), &quot;Edição 20C/40C e 20NC/40NC&quot;,

    /* 3. COMBINAÇÕES DE 3 CAMPOS */
    IF(AND({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, {!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}, {!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}), &quot;Edição 20C/40C/20NC&quot;,
    IF(AND({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, {!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}, {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}), &quot;Edição 20C/40C/40NC&quot;,
    IF(AND({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, {!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}, {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}), &quot;Edição 20C/20NC/40NC&quot;,
    IF(AND({!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}, {!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}, {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}), &quot;Edição 40C/20NC/40NC&quot;,

    /* 4. COMBINAÇÕES DE 2 CAMPOS (DUPLAS) */
    IF(AND({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, {!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}), &quot;Edição 20C/40C&quot;,
    IF(AND({!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}, {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}), &quot;Edição 20NC/40NC&quot;,
    IF(AND({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, {!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}), &quot;Edição 20C/20NC&quot;,
    IF(AND({!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}, {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}), &quot;Edição 40C/40NC&quot;,
    IF(AND({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, {!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}), &quot;Edição 20C/40NC&quot;,
    IF(AND({!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}, {!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}), &quot;Edição 40C/20NC&quot;,

    /* 5. TESTES INDIVIDUAIS */
    IF({!$Record.ValorCNTR20Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR20Consolidado__c}, &quot;Edição 20C&quot;,
    IF({!$Record.ValorCNTR20NaoConsolidado_ini__c} &lt;&gt; {!$Record.ValorCNTR20NaoConsolidado__c}, &quot;Edição 20NC&quot;,
    IF({!$Record.ValorCNTR40Consolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40Consolidado__c}, &quot;Edição 40C&quot;,
    IF({!$Record.ValorCNTR40NaoConsolidado_Ini__c} &lt;&gt; {!$Record.ValorCNTR40NaoConsolidado__c}, &quot;Edição 40NC&quot;,

    /* 6. FINAL */
    &quot;Não editado&quot;
    ))))))))))))))))</expression>
    </formulas>
