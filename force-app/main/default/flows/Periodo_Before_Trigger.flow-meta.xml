    <formulas>
        <name>LegendaFormulaTRG</name>
        <dataType>String</dataType>
        <expression>CASE(
	TEXT({!$Record.ClassificacaoFormulaPeriodoTRG__c}),
	&quot;Armexp&quot;,CASE(
					{!$Record.Periodo__c},
					1,&quot;Tarifa básica – &quot; + TEXT({!$Record.PercentualDoPeriodo__c}) +&quot; % do valor da carga&quot;,
					2,&quot;Período superiores a 10 dias - &quot; + TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % do valor da carga&quot;,
					3,&quot;Períodos superiores a 20 dias e subsequentes, até a estufagem da mercadoria – &quot; + TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % do valor da carga.&quot;,
					&quot;&quot;
				),
	&quot;Numero Dias Periodo Real&quot;,CASE(
									{!$Record.Periodo__c},
									1,&quot;Até o sétimo dia, por dia ou fração.................................................... R$ &quot; + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot;/container&quot;,
									2,&quot;A partir do oitavo dia, por dia ou fração............................. R$ &quot; + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot;/container&quot;,
									3,&quot;Até o décimo dia, por dia ou fração..................................................... R$ &quot; + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot;/container&quot;,
									4,&quot;A partir do décimo primeiro dia, por dia ou fração............................. R$ &quot; + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot;/container&quot;,
									&quot;&quot;
									),
	&quot;Numero Dias Periodo Real - Sob consulta&quot;, &quot;R$ &quot; + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot; / dia / container&quot;,
	&quot;Armazenagem cntr Vazio&quot;,CASE(
									{!$Record.Periodo__c},
									1,&quot;Tarifa básica.................................................... R$ &quot;  + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot;/unidade&quot;,
									2,&quot;No segundo período de 05 dias ou fração e pelos subsequentes............................. R$ &quot; + TEXT({!$Record.ValorDeCNTRPeriodo__c}) + &quot;/unidade&quot;,
									&quot;&quot;
								),
	&quot;Arm Imp LCL&quot;,CASE(
						{!$Record.Periodo__c},
						1,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – do 1° ao 5° dia, por dia (mínimo R$ &quot; +TEXT({!$Record.ValorMinimoPeriodo__c})+ &quot;/processo)&quot;,
						2,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – do 6° ao 10° dia, por dia (mínimo R$ &quot; +TEXT({!$Record.ValorMinimoPeriodo__c}) + &quot;/processo)&quot;,
						3,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – do 11° ao 15° dia, por dia (mínimo R$ &quot; +TEXT({!$Record.ValorMinimoPeriodo__c}) + &quot;/processo)&quot;,
						&quot;&quot;
					),
	&quot;Arm Imp FCL&quot;,CASE(
						{!$Record.Periodo__c},
						1,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – do 1° ao 5° dia, por dia (mínimo R$ &quot; +TEXT({!$Record.ValorMinimoPeriodo__c}) + &quot;/processo)&quot;,
						2,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – do 6° ao 10° dia, por dia (mínimo R$ &quot; +TEXT({!$Record.ValorMinimoPeriodo__c}) + &quot;/processo)&quot;,
						3,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – do 11° ao 15° dia, por dia (mínimo R$ &quot; +TEXT({!$Record.ValorMinimoPeriodo__c}) + &quot;/processo)&quot;,
						4,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; % * Valor CIF – Períodos superiores a quinze dias e subsequentes, por dia (mínimo R$ &quot; + TEXT({!$Record.ValorMinimoPeriodo__c})+&quot;/processo)&quot;,
						&quot;&quot;
					),
	&quot;Arm Imp LCL Greatest&quot;,CASE(
								{!$Record.Periodo__c},
								1,TEXT({!$Record.PercentualDoPeriodo__c}) + &quot; * Valor CIF – Períodos superiores a quinze dias e subsequentes, por dia (mínimo R$ &quot; + TEXT({!$Record.ValorMinimoPeriodo__c}) + &quot;/processo) Valor mínimo de R$ &quot; + TEXT({!$Record.ValorMinimoDiarioPorProcessoPeriodo__c}) + &quot;/dia, a partir do décimo sexto dia&quot;,
								&quot;&quot;
							),
	&quot;&quot;
)</expression>
    </formulas>
    <formulas>
