<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Primeiro_Nome_Obrigatorio</fullName>
    <active>false</active>
    <errorConditionFormula>AND(NOT(BypassValidationsFromBot__c),
ISBLANK(FirstName)
)</errorConditionFormula>
    <errorMessage>Os seguintes campos obrigatórios devem ser preenchidos: Primeiro Nome</errorMessage>
</ValidationRule>
