<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Telefone_ou_Celular_Preenchido</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(BypassValidationsFromBot__c),
ISBLANK( Phone ) &amp;&amp; ISBLANK( MobilePhone )
)</errorConditionFormula>
    <errorMessage>Um dos campos &quot;Telefone&quot; ou &quot;Celular&quot; deverá ser preenchido obrigatoriamente.</errorMessage>
</ValidationRule>
